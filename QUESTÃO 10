programa {
  funcao inicio() {

  inteiro nota, notaalta = 0, notabaixa = 0, contador = 1

  enquanto(contador <= 6){
    escreva("Digite a nota do cliente ", contador, "º (1 a 5): ")
    leia(nota)

      se(nota >= 4){
        notaalta = notaalta + 1
     }
        senao {
          notabaixa = notabaixa + 1
        }
    
    contador = contador + 1

  }

  escreva("\nResultado da Pesquisa")
  escreva("\nClientes que deram nota maior ou igual a 4: ", notaalta)
  escreva("\nClientes que deram nota menor que 4: ", notabaixa)


  }
}
