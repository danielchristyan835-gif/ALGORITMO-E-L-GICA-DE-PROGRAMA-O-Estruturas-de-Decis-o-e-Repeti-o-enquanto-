programa {
  funcao inicio() {

  real port, mat, conhger, media
  cadeia nome 

  escreva("Qual seu nome?: ")
  leia(nome)
  escreva("Digite a nota de Português: ")
  leia(port)
  escreva("Digite a nota de Matemática: ")
  leia(mat)
  escreva("Digite a nota de Conhecimentos Gerais: ")
  leia(conhger)

  media = (port + mat + conhger) / 3
  se (media > 7.0 e port >= 5.0 e mat >= 5.0 e conhger >= 5.0)
      escreva("Candidato Aprovado. Média: ", media)
   senao
      escreva("Candidato Reprovado. Média: ", media)

  
  }
}
