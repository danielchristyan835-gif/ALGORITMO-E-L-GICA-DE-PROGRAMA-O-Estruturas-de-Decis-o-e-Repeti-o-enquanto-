  escreva("Digite o segundo valor: ")
  leia(valor2)
  escreva("Digite o terceiro valor: ")
  leia(valor3)

  se (valor1 > valor2) {
    aux = valor1
    valor1 = valor2
    valor2 = aux
  }
  se (valor1 > valor3) {
   aux = valor1
    valor1 = valor3
